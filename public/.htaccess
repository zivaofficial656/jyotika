# Apache / cPanel / LiteSpeed / Hostinger Shared Hosting Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 301 Redirect old domain (jyotikaspa.com / www.jyotikaspa.com) to https://jyotika.online
  RewriteCond %{HTTP_HOST} ^(?:www\.)?jyotikaspa\.com$ [NC]
  RewriteRule ^(.*)$ https://jyotika.online/$1 [R=301,L]

  # 2. 301 Redirect www.jyotika.online to non-www https://jyotika.online
  RewriteCond %{HTTP_HOST} ^www\.jyotika\.online$ [NC]
  RewriteRule ^(.*)$ https://jyotika.online/$1 [R=301,L]

  # 3. Do not rewrite existing physical files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Directly serve technical SEO & metadata assets
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^og-image\.jpg$ - [L]
  RewriteRule ^favicon\.svg$ - [L]
  RewriteRule ^jyotika-spa-logo\.png$ - [L]
  RewriteRule ^jyotika-spa-logo\.svg$ - [L]
  RewriteRule ^llms\.txt$ - [L]
  RewriteRule ^ai-catalog\.json$ - [L]

  # 5. Fallback all React Router SPA client routes to index.html
  RewriteRule . /index.html [L]
</IfModule>
