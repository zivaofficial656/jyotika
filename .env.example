# Jyotika Spa Environment Configuration
# Production canonical website origin
VITE_SITE_URL=https://jyotika.online

# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Google Tag Manager Container ID (optional, e.g., GTM-XXXXXXX)
VITE_GTM_ID=

# Google Search Console HTML verification meta token (optional, DNS TXT is primary)
VITE_GSC_VERIFICATION=
